# Earth Jukebox - variables de entorno (ejemplo, sin valores reales)

# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Fuentes científicas
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NOAA_CDO_TOKEN=

# Fuentes de audio
FREESOUND_API_KEY=
XENO_CANTO_API_KEY=

# Seguridad
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Mapas (opcional: proveedor alternativo)
MAP_TILE_PROVIDER=osm
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT=EarthJukebox/0.1 (+https://example.org; contact: dev@example.org)
